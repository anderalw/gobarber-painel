# Servidor de verdade: HTTPS automático em todos os endereços.
#
# O painel fica no PANEL_DOMAIN. Qualquer outro endereço vai para o site do
# Pontual, que descobre a barbearia pelo próprio endereço. O certificado de
# cada um sai no primeiro acesso ("on demand"), só depois de a API confirmar
# que o endereço é de uma barbearia cadastrada (subdomínio ou domínio próprio)
{
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://api:3333/internal/domains/check
	}
}

{$PANEL_DOMAIN} {
	reverse_proxy panel:4000
}

https:// {
	tls {
		on_demand
	}

	reverse_proxy web:80
}
