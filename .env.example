# Copie para .env (não versionado)

# Seu acesso ao painel
PANEL_EMAIL=voce@suaempresa.com.br
PANEL_PASSWORD=troque-por-uma-senha-forte
# Assina a sessão do painel (texto longo e aleatório)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Endereço das barbearias: <identificador>.<BASE_DOMAIN>
# Testes no computador: "localhost" (ex.: http://barbearia-do-ze.localhost)
BASE_DOMAIN=localhost
# "off": só HTTP (testes); "auto": HTTPS automático (domínio de verdade)
TLS=off
# E-mail para os certificados HTTPS (com TLS=auto)
ACME_EMAIL=
# Porta pública do Caddy (com TLS=off; 80 no servidor)
PUBLIC_HTTP_PORT=80
# Painel no próprio Caddy, ex.: painel.suaempresa.com.br (vazio = sem)
PANEL_DOMAIN=

# Imagens do Pontual (publicadas pelo GitHub Actions)
API_IMAGE=ghcr.io/anderalw/pontual-api:latest
WEB_IMAGE=ghcr.io/anderalw/pontual-web:latest
# false: usa as imagens que já estão na máquina (testes locais)
PULL_IMAGES=true

# Onde ficam o banco do painel e as pastas das barbearias
DATA_DIR=data
# Administração do Caddy (no servidor, o compose troca para http://caddy:2019)
CADDY_ADMIN=http://127.0.0.1:2019
EDGE_NETWORK=gobarber-edge
PORT=4000
