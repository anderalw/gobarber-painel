# Copie para .env (não versionado). Vale para o servidor (infra/docker-compose.yml)
# e para rodar o painel no computador (yarn dev)

# Seu acesso ao painel
PANEL_EMAIL=voce@suaempresa.com.br
PANEL_PASSWORD=troque-por-uma-senha-forte
# Assina a sessão do painel (texto longo e aleatório: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Domínio do Pontual: cada barbearia abre em <identificador>.BASE_DOMAIN
# (no DNS: *.BASE_DOMAIN apontando para o servidor). No computador: localhost
BASE_DOMAIN=localhost
# Painel no próprio Caddy (no DNS, apontando para o servidor)
PANEL_DOMAIN=painel.localhost
# Página de divulgação e cadastro (e www.); vazio = o BASE_DOMAIN
SITE_DOMAIN=

# Cadastro pela página: dias de teste, mensalidade (centavos) e se o
# negócio é suspenso quando o teste acaba sem pagamento
SIGNUP_ENABLED=true
SIGNUP_TRIAL_DAYS=7
SIGNUP_PRICE_CENTS=9900
TRIAL_AUTO_SUSPEND=true
# WhatsApp de contato na área do cliente (com DDI, ex.: 5511999990000)
SUPPORT_WHATSAPP=
# E-mail para os certificados HTTPS
ACME_EMAIL=
# Como os links das barbearias abrem. Servidor: https://{host}
TENANT_WEB_URL=https://{host}

# Token que o painel usa nas rotas da plataforma da API (openssl rand -hex 32)
PLATFORM_TOKEN=troque-por-um-token-longo-e-aleatorio

# Segredo dos logins e das integrações (trocar desloga todo mundo)
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Senha do Postgres (só dentro do Docker)
DB_PASS=troque-esta-senha
# Fuso de todas as barbearias da instalação
TZ=America/Sao_Paulo

# E-mail: "ethereal" (testes) ou "ses" (Amazon SES)
MAIL_DRIVER=ethereal
MAIL_FROM=
# Login com Google (vazio = sem o botão)
GOOGLE_CLIENT_ID=

# Imagens (publicadas pelo GitHub Actions)
# API_IMAGE=ghcr.io/anderalw/pontual-api:latest
# WEB_IMAGE=ghcr.io/anderalw/pontual-web:latest
# PANEL_IMAGE=ghcr.io/anderalw/pontual-painel:latest

# Teste no computador sem HTTPS: Caddyfile.local e outra porta, se a 80 estiver ocupada
# CADDYFILE=Caddyfile.local
# PUBLIC_HTTP_PORT=8088

# --- Só para "yarn dev" (painel fora do Docker) ---
# API do Pontual rodando no computador e os links pelo Vite do site
PONTUAL_API=http://localhost:3333
SITE_URL=http://{host}:3000
DATA_DIR=data
PORT=4000
